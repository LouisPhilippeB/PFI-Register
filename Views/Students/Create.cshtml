@model Models.Student
@{
    ViewBag.Title = "Ajouter étudiant";
}

<div class="pageTitle">
    Ajouter un étudiant
    <a href="/Students/List" title="Retour">
        <span class="cmdIcon fa fa-arrow-left"></span>
    </a>
</div>

@using (Html.BeginForm())
{
    @Html.Partial("StudentForm", Model)

    <div class="formButtons">
        <a href="/Students/List" class="btn btn-secondary">Annuler</a>
        <input type="submit" value="Enregistrer" class="btn btn-primary" />
    </div>
}