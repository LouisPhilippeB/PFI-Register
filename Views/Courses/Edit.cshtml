@model Models.Course
@{
    ViewBag.Title = "Modifier cours";
}

<div class="pageTitle">
    Modifier un cours
    <a href="/Courses/Details/@Model.Id" title="Retour">
        <span class="cmdIcon fa fa-arrow-left"></span>
    </a>
</div>

@using (Html.BeginForm())
{
    @Html.Partial("CourseForm", Model)

    <div class="formButtons">
        <a href="/Courses/Details/@Model.Id" class="btn btn-secondary">Annuler</a>
        <input type="submit" value="Enregistrer" class="btn btn-primary" />
    </div>
}