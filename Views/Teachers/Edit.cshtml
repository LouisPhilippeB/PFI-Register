@model Models.Teacher
@{
    ViewBag.Title = "Modifier professeur";
}

<div class="pageTitle">
    Modifier un professeur
    <a href="/Teachers/Details/@Model.Id" title="Retour">
        <span class="cmdIcon fa fa-arrow-left"></span>
    </a>
</div>

@using (Html.BeginForm())
{
    @Html.Partial("TeacherForm", Model)

    <div class="formButtons">
        <a href="/Teachers/Details/@Model.Id" class="btn btn-secondary">Annuler</a>
        <input type="submit" value="Enregistrer" class="btn btn-primary" />
    </div>
}